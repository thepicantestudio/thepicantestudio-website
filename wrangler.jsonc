{
  "name": "thepicantestudio-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "send_email": [
    { "name": "LEADS", "destination_address": "thepicantestudio@gmail.com" }
  ],
  // Per-IP cap on POST /api/lead: five submissions a minute per Cloudflare location.
  // Declared under "unsafe" because the wrangler used by Workers Builds ignored the top-level "ratelimits" key.
  "unsafe": {
    "bindings": [
      { "name": "LEAD_RL", "type": "ratelimit", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
    ]
  },
  "observability": { "enabled": true }
}
